<?xml version="1.0" encoding="UTF-8"?>
<HTTPService xmlns="http://v8.1c.ru/8.3/xcf/extrnform" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:cnt="http://v8.1c.ru/8.1/data/contest" xmlns:form="http://v8.1c.ru/8.3/xcf/extrnform" xmlns:sec="http://v8.1c.ru/8.1/data/securetype" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsdata="http://xsdata.dev/1.2/schema" xmlns:dt="http://v8.1c.ru/8.1/data/core" xmlns:base="http://v8.1c.ru/XMLData">
	<Name>TaxCalculateService</Name>
	<UseDataControlLines>ForExtendedAttributes</UseDataControlLines>
	<ExposeKey/>
	<Expose/>
	<Path>/api/v1/taxes/calculate</Path>
	<HttpMethod>POST</HttpMethod>
	<Authentication>
		<BearerToken>true</BearerToken>
		<AllowAnonymous>false</AllowAnonymous>
	</Authentication>
	<Parameters>
		<Parameter>
			<Name>tax</Name>
			<Type>CatalogRef:Taxes</Type>
			<Required>true</Required>
		</Parameter>
		<Parameter>
			<Name>period</Name>
			<Type>CatalogRef:Periods</Type>
			<Required>true</Required>
		</Parameter>
		<Parameter>
			<Name>traceparent</Name>
			<Type>String</Type>
			<Length>55</Length>
			<Required>false</Required>
		</Parameter>
	</Parameters>
	<Reply>
		<Status>200</Status>
		<ContentType>application/json</ContentType>
		<Body>
			<Structure>
				<Field>
					<Name>tax</Name>
					<Type>CatalogRef:Taxes</Type>
				</Field>
				<Field>
					<Name>period</Name>
					<Type>CatalogRef:Periods</Type>
				</Field>
				<Field>
					<Name>amount</Name>
					<Type>Number</Type>
					<Number>
						<FirstNumber>0</FirstNumber>
						<Len>17</Len>
						<DecimalWidth>2</DecimalWidth>
						<NegativeProcessed>True</NegativeProcessed>
					</Number>
				</Field>
				<Field>
					<Name>rate</Name>
					<Type>String</Type>
					<Length>10</Length>
				</Field>
				<Field>
					<Name>article</Name>
					<Type>String</Type>
					<Length>20</Length>
				</Field>
				<Field>
					<Name>as_of_date</Name>
					<Type>Date</Type>
				</Field>
				<Field>
					<Name>trace_id</Name>
					<Type>String</Type>
					<Length>36</Length>
				</Field>
			</Structure>
		</Body>
	</Reply>
	<ErrorReply>
		<Status>401</Status>
		<ContentType>application/json</ContentType>
		<Body>
			<Structure>
				<Field>
					<Name>error</Name>
					<Type>String</Type>
					<Length>255</Length>
				</Field>
				<Field>
					<Name>trace_id</Name>
					<Type>String</Type>
					<Length>36</Length>
				</Field>
			</Structure>
		</Body>
	</ErrorReply>
</HTTPService>
