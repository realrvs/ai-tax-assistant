<?xml version="1.0" encoding="UTF-8"?>
<HTTPService xmlns="http://v8.1c.ru/8.3/xcf/extrnform" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:cnt="http://v8.1c.ru/8.1/data/contest" xmlns:form="http://v8.1c.ru/8.3/xcf/extrnform" xmlns:sec="http://v8.1c.ru/8.1/data/securetype" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsdata="http://xsdata.dev/1.2/schema" xmlns:dt="http://v8.1c.ru/8.1/data/core" xmlns:base="http://v8.1c.ru/XMLData">
	<Name>DocumentSearchService</Name>
	<UseDataControlLines>ForExtendedAttributes</UseDataControlLines>
	<ExposeKey/>
	<Expose/>
	<Path>/api/v1/documents/search</Path>
	<HttpMethod>GET</HttpMethod>
	<Authentication>
		<BearerToken>true</BearerToken>
		<AllowAnonymous>false</AllowAnonymous>
	</Authentication>
	<Parameters>
		<Parameter>
			<Name>type</Name>
			<Type>String</Type>
			<Length>50</Length>
			<Required>false</Required>
		</Parameter>
		<Parameter>
			<Name>number</Name>
			<Type>String</Type>
			<Length>20</Length>
			<Required>false</Required>
		</Parameter>
		<Parameter>
			<Name>from_date</Name>
			<Type>Date</Type>
			<Required>false</Required>
		</Parameter>
		<Parameter>
			<Name>to_date</Name>
			<Type>Date</Type>
			<Required>false</Required>
		</Parameter>
		<Parameter>
			<Name>traceparent</Name>
			<Type>String</Type>
			<Length>55</Length>
			<Required>false</Required>
		</Parameter>
	</Parameters>
	<Reply>
		<Status>200</Status>
		<ContentType>application/json</ContentType>
		<Body>
			<Structure>
				<Field>
					<Name>total</Name>
					<Type>Number</Type>
					<Number>
						<FirstNumber>0</FirstNumber>
						<Len>10</Len>
						<DecimalWidth>0</DecimalWidth>
						<NegativeProcessed>False</NegativeProcessed>
					</Number>
				</Field>
				<Field>
					<Name>documents</Name>
					<Type>Array</Type>
				</Field>
				<Field>
					<Name>trace_id</Name>
					<Type>String</Type>
					<Length>36</Length>
				</Field>
			</Structure>
		</Body>
	</Reply>
	<ErrorReply>
		<Status>401</Status>
		<ContentType>application/json</ContentType>
		<Body>
			<Structure>
				<Field>
					<Name>error</Name>
					<Type>String</Type>
					<Length>255</Length>
				</Field>
				<Field>
					<Name>trace_id</Name>
					<Type>String</Type>
					<Length>36</Length>
				</Field>
			</Structure>
		</Body>
	</ErrorReply>
</HTTPService>
